from fastapi import FastAPI, Request, Form
from fastapi.responses import HTMLResponse, RedirectResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
from sqlalchemy import create_engine, Column, Integer, String, DateTime
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker
from datetime import datetime
import os

app = FastAPI()

# Подключение к базе данных
DATABASE_PATH = os.path.abspath("../predictions.db")
DATABASE_URL = f"sqlite:///{DATABASE_PATH}"

engine = create_engine(DATABASE_URL)
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)
Base = declarative_base()

# Модель прогноза
class Prediction(Base):
    __tablename__ = "predictions"

    id = Column(Integer, primary_key=True, index=True)
    league = Column(String, index=True)
    home_team = Column(String)
    away_team = Column(String)
    match_datetime = Column(DateTime)
    prediction_type = Column(String)

Base.metadata.create_all(bind=engine)

# Указываем абсолютный путь к папке static
STATIC_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "static")
templates = Jinja2Templates(directory=STATIC_DIR)
app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")

@app.get("/", response_class=HTMLResponse)
async def read_root(request: Request):
    db = SessionLocal()
    predictions = db.query(Prediction).all()
    db.close()
    return templates.TemplateResponse("index.html", {"request": request, "predictions": predictions})

@app.post("/add")
async def add_prediction(
    league: str = Form(...),
    home_team: str = Form(...),
    away_team: str = Form(...),
    match_datetime: datetime = Form(...),
    prediction_type: str = Form(...)
):
    db = SessionLocal()
    prediction = Prediction(
        league=league,
        home_team=home_team,
        away_team=away_team,
        match_datetime=match_datetime,
        prediction_type=prediction_type
    )
    db.add(prediction)
    db.commit()
    db.refresh(prediction)
    db.close()
    return RedirectResponse("/", status_code=303)

@app.post("/delete/{prediction_id}")
async def delete_prediction(prediction_id: int):
    db = SessionLocal()
    prediction = db.query(Prediction).filter(Prediction.id == prediction_id).first()
    db.delete(prediction)
    db.commit()
    db.close()
    return RedirectResponse("/", status_code=303)

# ✅ Маршрут для API
@app.get("/api/predictions")
async def get_predictions_api():
    db = SessionLocal()
    predictions = db.query(Prediction).all()
    db.close()

    result = []
    for p in predictions:
        result.append({
            "id": p.id,
            "league": p.league,
            "home_team": p.home_team,
            "away_team": p.away_team,
            "match_datetime": p.match_datetime.isoformat(),
            "prediction_type": p.prediction_type
        })

    return JSONResponse(result)

# Маршрут для удаления всех
@app.post("/delete_all")
async def delete_all_predictions():
    db = SessionLocal()
    db.query(Prediction).delete()
    db.commit()
    db.close()
    return {"status": "success"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
