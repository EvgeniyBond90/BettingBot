<!DOCTYPE html>
<html lang="ru">
<head>
    <title>Football Predictions Admin</title>
    <meta charset="utf-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            background-color: #f9f9f9;
        }
        input, select {
            width: 300px;
            padding: 8px;
            margin: 6px 0;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        button {
            padding: 10px 20px;
            margin-top: 15px;
            background-color: #2c3e50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        button:hover {
            background-color: #1a252f;
        }
        table {
            border-collapse: collapse;
            margin-top: 30px;
            width: 100%;
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #ecf0f1;
        }
        h1, h2 {
            color: #2c3e50;
        }

        /* Стили для списка лиг */
        .league-container {
            position: relative;
            display: inline-block;
            width: 300px;
        }

        .league-search {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .league-list {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 1000;
            background: white;
            border: 1px solid #ccc;
            border-top: none;
            max-height: 300px;
            overflow-y: auto;
            display: none;
        }

        .league-option {
            padding: 8px;
            cursor: pointer;
        }

        .league-option:hover {
            background-color: #f0f0f0;
        }
    </style>
</head>
<body>
    <h1>Добавить прогноз</h1>
    <form method="post" action="/add">
        <div class="league-container">
            <input type="text" class="league-search" id="leagueInput" placeholder="Поиск лиги..." autocomplete="off">
            <div class="league-list" id="leagueList">
                <!-- Европа -->
                <div class="league-option" data-value="АПЛ">Англия - Премьер-лига</div>
                <div class="league-option" data-value="Чемпионшип">Англия - Чемпионшип</div>
                <div class="league-option" data-value="Англия_Лига_1">Англия - Лига 1</div>
                <div class="league-option" data-value="Ла Лига">Испания - Ла Лига</div>
                <div class="league-option" data-value="Сегунда">Испания - Сегунда</div>
                <div class="league-option" data-value="РФЕФ_Группа_1">Испания - РФЕФ - Группа 1</div>
                <div class="league-option" data-value="Серия А">Италия - Серия А</div>
                <div class="league-option" data-value="Серия B">Италия - Серия B</div>
                <div class="league-option" data-value="Серия С - группа А">Италия - Серия С, группа А</div>
                <div class="league-option" data-value="Серия С - группа B">Италия - Серия С, группа B</div>
                <div class="league-option" data-value="Серия С - группа C">Италия - Серия С, группа C</div>
                <div class="league-option" data-value="Бундеслига">Германия - Бундеслига</div>
                <div class="league-option" data-value="Бундеслига 2">Германия - Бундеслига 2</div>
                <div class="league-option" data-value="Лига 1">Франция - Лига 1</div>
                <div class="league-option" data-value="Лига 2">Франция - Лига 2</div>
                <div class="league-option" data-value="Эредивизи">Нидерланды - Эредивизи</div>
                <div class="league-option" data-value="Примейра Лига">Португалия - Примейра Лига</div>
                <div class="league-option" data-value="Жупиле Лига">Бельгия - Жупиле Лига</div>
                <div class="league-option" data-value="Немзети лига">Венгрия - Немзети лига</div>
                <div class="league-option" data-value="Суперлига">Турция - Суперлига</div>
                <div class="league-option" data-value="РПЛ">Россия - РПЛ</div>
                <div class="league-option" data-value="Премьер-лига Украины">Украина - Премьер-лига</div>
                <div class="league-option" data-value="Премьер-лига Шотландии">Шотландия - Премьер-лига</div>
                <div class="league-option" data-value="Чехия - Экстракласа">Чехия - Экстракласа</div>
                <div class="league-option" data-value="Польша_Премьер-лига">Польша - Премьер-лига</div>
                <div class="league-option" data-value="Бундеслига (Австрия)">Австрия - Бундеслига</div>
                <div class="league-option" data-value="Суперлига (Швейцария)">Швейцария - Суперлига</div>
                <div class="league-option" data-value="Суперлига (Дания)">Дания - Суперлига</div>
                <div class="league-option" data-value="Элитесерия">Норвегия - Элитесерия</div>
                <div class="league-option" data-value="Оллсвенскан">Швеция - Оллсвенскан</div>
                <div class="league-option" data-value="Вейккауслига">Финляндия - Вейккауслига</div>
                <div class="league-option" data-value="Суперлига (Греция)">Греция - Суперлига</div>
                <div class="league-option" data-value="Прва ХНЛ">Хорватия - Прва ХНЛ</div>
                <div class="league-option" data-value="Приморье (Словения)">Словения - Приморье</div>
                <div class="league-option" data-value="Суперлига Сербии">Сербия - Суперлига</div>
                <div class="league-option" data-value="Лига I">Румыния - Лига I</div>
                <div class="league-option" data-value="Първа лига">Болгария - Първа лига</div>
                <div class="league-option" data-value="Немзети байноксаг">Венгрия - Немзети байноксаг</div>
                <div class="league-option" data-value="Словацкая экстралига">Словакия - Экстралига</div>
                <div class="league-option" data-value="Прва лига БиГ">Босния и Герцеговина - Прва лига</div>
                <div class="league-option" data-value="Суперлига (Албания)">Албания - Суперлига</div>
                <div class="league-option" data-value="Прва лига (Македония)">Северная Македония - Прва лига</div>
                <div class="league-option" data-value="Высшая лига (Латвия)">Латвия - Высшая лига</div>
                <div class="league-option" data-value="А-лига (Литва)">Литва - А-лига</div>
                <div class="league-option" data-value="Меистрилига">Эстония - Меистрилига</div>
                <div class="league-option" data-value="Национальная лига (Молдавия)">Молдавия - Национальная лига</div>
                <div class="league-option" data-value="Премьер-лига Армении">Армения - Премьер-лига</div>
                <div class="league-option" data-value="Премьер-лига Азербайджана">Азербайджан - Премьер-лига</div>
                <div class="league-option" data-value="Премьер-лига Казахстана">Казахстан - Премьер-лига</div>

                <!-- Азия -->
                <div class="league-option" data-value="Джей-лига">Япония - Джей-лига</div>
                <div class="league-option" data-value="K-лига">Южная Корея - K-лига</div>
                <div class="league-option" data-value="A-League">Австралия - A-League</div>
                <div class="league-option" data-value="Персидская лига">Иран - Персидская лига</div>
                <div class="league-option" data-value="1-я лига (Индонезия)">Индонезия - 1-я лига</div>

                <!-- Европейские турниры -->
                <div class="league-option" data-value="Лига чемпионов УЕФА">Европа - Лига чемпионов УЕФА</div>
                <div class="league-option" data-value="Лига Европы УЕФА">Европа - Лига Европы УЕФА</div>
                <div class="league-option" data-value="Лига конференций УЕФА">Европа - Лига конференций УЕФА</div>
            </div>
            <input type="hidden" name="league" id="leagueValue" required>
        </div><br>

        <select name="home_team" id="homeTeamSelect" required>
            <option value="">— Выберите хозяев —</option>
        </select><br>

        <select name="away_team" id="awayTeamSelect" required>
            <option value="">— Выберите гостей —</option>
        </select><br>

        <input name="match_datetime" type="datetime-local" required><br>

        <select name="prediction_type" required>
            <option value="">— Выберите тип ставки —</option>
            <option value="Победа 1 или Ничья">1X</option>
            <option value="Ничья или Победа 2">X2</option>
            <option value="Победа 1">Победа 1</option>
            <option value="Победа 2">Победа 2</option>
            <option value="Победа 1-тайм К1">Победа 1-тайм К1</option>
            <option value="Победа 1-тайм К2">Победа 1-тайм К2</option>
            <option value="Победа 1 или Ничья в 1-м тайме">Победа 1 или Ничья в 1-м тайме</option>
            <option value="Победа 2 или Ничья в 1-м тайме">Победа 2 или Ничья в 1-м тайме</option>
            <option value="Обе забьют">Обе забьют гол - да</option>
            <option value="Не обе забьют">Обе забьют -  нет</option>
            <option value="Больше 2.5 голов">Больше 2.5 голов</option>
            <option value="Меньше 2.5 голов">Меньше 2.5 голов</option>
            <option value="Больше 1.5 голов">Больше 1.5 голов</option>
            <option value="Меньше 1.5 голов">Меньше 1.5 голов</option>
            <option value="Больше 1.5 голов — команда 1">Больше 1.5 голов — команда 1</option>
            <option value="Больше 1.5 голов — команда 2">Больше 1.5 голов — команда 2</option>
            <option value="Гол команды 1">Гол команды 1</option>
            <option value="Гол команды 2">Гол команды 2</option>
            <option value="К1 забьет 1 гол">К1 забьет 1 гол</option>
            <option value="К2 забьет 1 гол">К2 забьет 1 гол</option>
            <option value="Фора(0)1">Фора(0)1</option>
	    <option value="Фора(0)2">Фора(0)2</option>
	    <option value="Фора(0)1 1-тайм">Фора(0)1 1-тайм</option>
	    <option value="Фора(0)2 2-тайм">Фора(0)2 1-тайм</option>
        </select><br>

        <button type="submit">Добавить</button>
    </form>

    <h2>Существующие прогнозы</h2>
    <table>
        <thead>
            <tr>
                <th>Лига</th>
                <th>Матч</th>
                <th>Время</th>
                <th>Ставка</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            {% for p in predictions %}
            <tr>
                <td>{{ p.league }}</td>
                <td>{{ p.home_team }} – {{ p.away_team }}</td>
                <td>{{ p.match_datetime.strftime('%Y-%m-%d %H:%M') }}</td>
                <td>{{ p.prediction_type }}</td>
                <td>
                    <form method="post" action="/delete/{{ p.id }}" style="display:inline;" onsubmit="return confirm('Удалить этот прогноз?');">
                        <button type="submit" style="color:red; border:none; background:none; cursor:pointer;">❌</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <!-- ✅ Новая кнопка "Удалить все прогнозы" -->
    <button onclick="deleteAllPredictions()">🗑 Удалить все прогнозы</button>

    <script>
        const leagueInput = document.getElementById('leagueInput');
        const leagueList = document.getElementById('leagueList');
        const leagueValue = document.getElementById('leagueValue');
        const homeSelect = document.getElementById('homeTeamSelect');
        const awaySelect = document.getElementById('awayTeamSelect');

        // Маппинг короткого названия лиги → полного
