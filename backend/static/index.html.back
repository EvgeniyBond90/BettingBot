                "Фиорентина", "Базель", "Рейнджерс", "Мальмё", "Лацио", "Марсель", "Фейеноорд", "Аякс", "ПСВ", "Атлетико", "Вильярреал", "Байер", "Шахтёр", "Зенит", "Динамо", "Ред Стар", "Бенфика", "Порту", "Реал Мадрид", "Барселона"
            ]
        };

        // Обновляем списки команд при выборе лиги
        function updateTeamLists(league) {
            const teams = teamsByLeague[league] || [];
            const homeOptions = teams.map(team => `<option value="${team}">${team}</option>`).join('');
            const awayOptions = teams.map(team => `<option value="${team}">${team}</option>`).join('');

            homeSelect.innerHTML = '<option value="">— Выберите хозяев —</option>' + homeOptions;
            awaySelect.innerHTML = '<option value="">— Выберите гостей —</option>' + awayOptions;
        }

        // Выбираем лигу при клике
        leagueList.addEventListener('click', (e) => {
            if (e.target.classList.contains('league-option')) {
                const value = e.target.getAttribute('data-value');
                const text = e.target.textContent;

                leagueInput.value = text;
                leagueValue.value = value;
                leagueList.style.display = 'none';

                // Обновляем списки команд
                updateTeamLists(value);
            }
        });

        // Показываем список при фокусе
        leagueInput.addEventListener('focus', () => {
            leagueList.style.display = 'block';
        });

        // Фильтруем лиги по вводу
        leagueInput.addEventListener('input', () => {
            const filter = leagueInput.value.toLowerCase();
            const options = leagueList.querySelectorAll('.league-option');

            options.forEach(option => {
                const text = option.textContent.toLowerCase();
                if (text.includes(filter)) {
                    option.style.display = 'block';
                } else {
                    option.style.display = 'none';
                }
            });

            leagueList.style.display = 'block';
        });

        // Скрываем список при потере фокуса
        leagueInput.addEventListener('blur', () => {
            setTimeout(() => {
                leagueList.style.display = 'none';
            }, 200);
        });

        // Функция удаления всех прогнозов
        async function deleteAllPredictions() {
            if (!confirm('Вы уверены, что хотите удалить ВСЕ прогнозы? Это действие нельзя отменить.')) {
                return;
            }

            try {
                const response = await fetch('/delete_all', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                if (response.ok) {
                    alert('Все прогнозы успешно удалены.');
                    location.reload(); // Перезагружаем страницу
                } else {
                    alert('Ошибка при удалении прогнозов. Проверьте консоль.');
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Произошла ошибка. Проверьте консоль.');
            }
        }

        // Заменяем короткие названия лиг на полные в таблице
        document.addEventListener('DOMContentLoaded', () => {
            const leagueCells = document.querySelectorAll('tbody tr td:first-child');
            leagueCells.forEach(cell => {
                const shortName = cell.textContent.trim();
                if (leagueMap[shortName]) {
                    cell.textContent = leagueMap[shortName];
                }
            });
        });
    </script>
</body>
</html>
